{
  "name": "karpathy-guidelines",
  "displayName": "Karpathy Guidelines",
  "description": "Apply Andrej Karpathy's behavioral guidelines across Claude Code, Codex, OpenCode, Gemini CLI, Cursor, Windsurf, Copilot, Cline, Continue, and Aider.",
  "version": "1.1.4",
  "publisher": "benpay",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nextransit/andrej-karpathy-skills"
  },
  "bugs": {
    "url": "https://github.com/nextransit/andrej-karpathy-skills/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "guidelines",
    "best-practices",
    "coding",
    "LLM",
    "AI",
    "karpathy",
    "claude",
    "cursor",
    "copilot",
    "windsurf",
    "cline",
    "continue",
    "codex",
    "opencode"
  ],
  "activationEvents": [
    "*",
    "onCommand:karpathy-guidelines.show",
    "onCommand:karpathy-guidelines.quickRef",
    "onCommand:karpathy-guidelines.insertRules",
    "onCommand:karpathy-guidelines.createConfig",
    "onCommand:karpathy-guidelines.createDetectedConfigs",
    "onCommand:karpathy-guidelines.createAllConfigs",
    "onCommand:karpathy-guidelines.listTools",
    "onCommand:karpathy-guidelines.checkConfigs",
    "onCommand:karpathy-guidelines.installGlobal",
    "onCommand:karpathy-guidelines.installWorkspace",
    "onCommand:karpathy-guidelines.installLocal",
    "onCommand:karpathy-guidelines.installGlobalAll",
    "onCommand:karpathy-guidelines.openSettings",
    "onCommand:karpathy-guidelines.refreshSkills"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "karpathy-guidelines.show",
        "title": "Karpathy: Show Rules",
        "description": "Display the full behavioral guidelines in a new tab"
      },
      {
        "command": "karpathy-guidelines.quickRef",
        "title": "Karpathy: Quick Reference",
        "description": "Open the quick reference panel with four principles"
      },
      {
        "command": "karpathy-guidelines.insertRules",
        "title": "Karpathy: Insert into Current File",
        "description": "Insert guidelines at cursor position (as comments or markdown)"
      },
      {
        "command": "karpathy-guidelines.createConfig",
        "title": "Karpathy: Create Configs for Selected Tools",
        "description": "Generate config files for one or more selected AI coding tools"
      },
      {
        "command": "karpathy-guidelines.createDetectedConfigs",
        "title": "Karpathy: Create Detected Tool Configs",
        "description": "Detect AI tools from the workspace and generate compatible config files"
      },
      {
        "command": "karpathy-guidelines.createAllConfigs",
        "title": "Karpathy: Create All Supported Configs",
        "description": "Generate config files for every supported AI coding tool"
      },
      {
        "command": "karpathy-guidelines.listTools",
        "title": "Karpathy: List Supported Tools",
        "description": "Show supported AI coding tools and the files generated for them"
      },
      {
        "command": "karpathy-guidelines.checkConfigs",
        "title": "Karpathy: Check Workspace Configs",
        "description": "Check which config files exist in the current workspace"
      },
      {
        "command": "karpathy-guidelines.installGlobal",
        "title": "Karpathy: Install Global Skills",
        "description": "Install the selected skill to global skill folders for selected CLI tools"
      },
      {
        "command": "karpathy-guidelines.installWorkspace",
        "title": "Karpathy: Install Workspace Skill",
        "description": "Open the install dialog and write the selected skill into the current workspace"
      },
      {
        "command": "karpathy-guidelines.installLocal",
        "title": "Karpathy: Install Local Skill",
        "description": "Open the install dialog and write the selected skill into the current workspace"
      },
      {
        "command": "karpathy-guidelines.installGlobalAll",
        "title": "Karpathy: Install All Global Skills",
        "description": "Open the install dialog with every globally installable tool selected"
      },
      {
        "command": "karpathy-guidelines.openSettings",
        "title": "Karpathy: Open Settings",
        "description": "Open the Karpathy install and configuration dialog"
      },
      {
        "command": "karpathy-guidelines.refreshSkills",
        "title": "Karpathy: Refresh Popular AI Skills",
        "description": "Fetch popular GitHub AI skill repositories updated in the last 30 days"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "karpathy-guidelines.insertRules",
          "when": "editorTextFocus",
          "group": "karpathy@1"
        },
        {
          "command": "karpathy-guidelines.show",
          "when": "editorTextFocus",
          "group": "karpathy@2"
        },
        {
          "command": "karpathy-guidelines.quickRef",
          "when": "editorTextFocus",
          "group": "karpathy@3"
        }
      ],
      "explorer/context": [
        {
          "command": "karpathy-guidelines.createConfig",
          "when": "explorerResourceIsFolder",
          "group": "karpathy@1"
        },
        {
          "command": "karpathy-guidelines.createAllConfigs",
          "when": "explorerResourceIsFolder",
          "group": "karpathy@2"
        },
        {
          "command": "karpathy-guidelines.createDetectedConfigs",
          "when": "explorerResourceIsFolder",
          "group": "karpathy@3"
        },
        {
          "command": "karpathy-guidelines.checkConfigs",
          "when": "explorerResourceIsFolder",
          "group": "karpathy@4"
        }
      ],
      "commandPalette": [
        {
          "command": "karpathy-guidelines.createAllConfigs",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "karpathy-guidelines.createDetectedConfigs",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "karpathy-guidelines.installWorkspace",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "karpathy-guidelines.installLocal",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "karpathy-guidelines.installGlobal"
        },
        {
          "command": "karpathy-guidelines.installGlobalAll"
        },
        {
          "command": "karpathy-guidelines.openSettings"
        },
        {
          "command": "karpathy-guidelines.refreshSkills"
        }
      ]
    },
    "configuration": {
      "title": "Karpathy Guidelines",
      "properties": {
        "karpathyGuidelines.insertAs": {
          "type": "string",
          "default": "markdown",
          "enum": [
            "markdown",
            "comments",
            "plaintext"
          ],
          "description": "Format when inserting guidelines into current file"
        },
        "karpathyGuidelines.autoActivate": {
          "type": "boolean",
          "default": false,
          "description": "Show quick reference when opening markdown files"
        },
        "karpathyGuidelines.defaultTool": {
          "type": "string",
          "default": "cursor",
          "enum": [
            "claude-code",
            "codex",
            "opencode",
            "gemini-cli",
            "aider",
            "cursor",
            "windsurf",
            "copilot",
            "cline",
            "continue"
          ],
          "description": "Default tool preselected in the target picker"
        },
        "karpathyGuidelines.defaultSkill": {
          "type": "string",
          "default": "karpathy-guidelines",
          "description": "Default AI skill selected in the install dialog. Karpathy Guidelines remains the fallback when GitHub skills cannot be fetched."
        },
        "karpathyGuidelines.overwriteExisting": {
          "type": "boolean",
          "default": true,
          "description": "Overwrite existing config files without prompting"
        },
        "karpathyGuidelines.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "description": "Language for generated configs: auto (system), en (English), zh-CN (Chinese)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ --sourceMap false",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/nextransit/andrej-karpathy-skills/vscode-extension/vscode-extension",
    "publish": "vsce publish --baseImagesUrl https://raw.githubusercontent.com/nextransit/andrej-karpathy-skills/vscode-extension/vscode-extension"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.3.2"
  }
}
